# .env.uat.example
# COMKEY AFYA POA — UAT (User Acceptance Testing) Configuration
# Self-contained in-memory mock adapters for regression and automated patient journeys

NODE_ENV=test
PORT=4000
WEB_PORT=3000

JWT_SECRET=uat-test-jwt-secret-min-32-characters-entropy
JWT_EXPIRATION=1h
REFRESH_TOKEN_SECRET=uat-test-refresh-token-secret-min-32-chars
REFRESH_TOKEN_EXPIRATION=7d
KMS_PEPPER_SECRET=uat-test-blind-index-pepper-secret-32-chars

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=afyapoa_user
DATABASE_PASSWORD=afyapoa_dev_password
DATABASE_NAME=afyapoa_db
DATABASE_URL=postgresql://afyapoa_user:afyapoa_dev_password@localhost:5432/afyapoa_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

INTEGRATION_MODE=MOCK
INTEGRATION_DRIVER=MOCK

DHA_HIE_BASE_URL=http://localhost:4010/dha
DHA_CLIENT_ID=uat-mock-client-id
DHA_CLIENT_SECRET=uat-mock-client-secret
DHA_DEFAULT_FACILITY_ID=FID-01-000001-1

SHA_CLAIMS_BASE_URL=http://localhost:4010/sha
SHA_API_KEY=uat-mock-api-key
SHA_FACILITY_CODE=FID-01-000001-1

KRA_ETIMS_BASE_URL=http://localhost:4010/etims
KRA_ETIMS_PIN=P000000000A
KRA_ETIMS_DEVICE_ID=ETIMS-DEV-DEVICE-001

MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=uat-mock-consumer-key
MPESA_CONSUMER_SECRET=uat-mock-consumer-secret
MPESA_SHORTCODE=174379
