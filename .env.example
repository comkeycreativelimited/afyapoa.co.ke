# ==============================================================================
# COMKEY AFYA POA — Environment Configuration Template (.env.example)
#
# IMPORTANT: All values below are non-sensitive placeholders for development.
# NEVER commit real credentials, production keys, or private certificates.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000
MOCK_SERVER_PORT=4010

# Security & Multi-Tenant Cryptography
JWT_SECRET=dev-insecure-jwt-secret-min-32-chars-length-replace-in-prod
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=dev-insecure-refresh-token-secret-replace-in-prod
REFRESH_TOKEN_EXPIRATION=7d
KMS_PEPPER_SECRET=dev-insecure-hmac-sha256-blind-index-pepper-key-min-32-chars

# PostgreSQL Database (with Row-Level Security)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=afyapoa_user
DATABASE_PASSWORD=afyapoa_dev_password
DATABASE_NAME=afyapoa_db
DATABASE_URL=postgresql://afyapoa_user:afyapoa_dev_password@localhost:5432/afyapoa_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis Cache & BullMQ Background Workers
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Integration Drivers: MOCK | SANDBOX | PRODUCTION
INTEGRATION_DRIVER=MOCK

# DHA Health Information Exchange (HIE) Configuration
DHA_HIE_BASE_URL=http://localhost:4010/dha
DHA_CLIENT_ID=dev-dha-client-id-placeholder
DHA_CLIENT_SECRET=dev-dha-client-secret-placeholder
DHA_DEFAULT_FACILITY_ID=FID-01-000001-1

# SHA eClaims Gateway Configuration
SHA_CLAIMS_BASE_URL=http://localhost:4010/sha
SHA_API_KEY=dev-sha-api-key-placeholder
SHA_FACILITY_CODE=FID-01-000001-1

# KRA eTIMS System-to-System Invoicing
KRA_ETIMS_BASE_URL=http://localhost:4010/etims
KRA_ETIMS_PIN=P000000000A
KRA_ETIMS_DEVICE_ID=ETIMS-DEV-DEVICE-001

# Safaricom Daraja M-Pesa Integration
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=dev-daraja-consumer-key-placeholder
MPESA_CONSUMER_SECRET=dev-daraja-consumer-secret-placeholder
MPESA_SHORTCODE=174379
MPESA_PASSKEY=dev-daraja-passkey-placeholder
MPESA_CALLBACK_URL=http://localhost:4000/api/v1/payments/mpesa/c2b-callback

# Structured Logging & Observability
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
