# .env.production.example
# COMKEY AFYA POA — Production Environment Configuration
# Mandate: All values must be securely provisioned via HashiCorp Vault or AWS Secrets Manager.
# DO NOT COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL.

NODE_ENV=production
PORT=4000
WEB_PORT=3000

# Security (Entropy requirement: >= 32 characters, randomly generated)
JWT_SECRET=__PROD_VAULT_INJECTED_JWT_SECRET_MIN_32_CHARS__
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=__PROD_VAULT_INJECTED_REFRESH_TOKEN_SECRET_MIN_32_CHARS__
REFRESH_TOKEN_EXPIRATION=7d
KMS_PEPPER_SECRET=__PROD_VAULT_INJECTED_BLIND_INDEX_PEPPER_SECRET_32_CHARS__

# Sovereign PostgreSQL Database (Nairobi Node)
DATABASE_HOST=db.prod.internal.afyapoa.co.ke
DATABASE_PORT=5432
DATABASE_USER=afyapoa_app
DATABASE_PASSWORD=__PROD_VAULT_INJECTED_DB_PASSWORD__
DATABASE_NAME=afyapoa_prod_db
DATABASE_URL=postgresql://afyapoa_app:__PROD_VAULT_INJECTED_DB_PASSWORD__@db.prod.internal.afyapoa.co.ke:5432/afyapoa_prod_db?sslmode=verify-full
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=50

# Sovereign Redis Cluster (TLS In-Transit & At-Rest)
REDIS_HOST=redis.prod.internal.afyapoa.co.ke
REDIS_PORT=6379
REDIS_PASSWORD=__PROD_VAULT_INJECTED_REDIS_AUTH_TOKEN__
REDIS_URL=rediss://:__PROD_VAULT_INJECTED_REDIS_AUTH_TOKEN__@redis.prod.internal.afyapoa.co.ke:6379

# Integration Mode: PROD (Live verified gateways)
INTEGRATION_MODE=PROD
INTEGRATION_DRIVER=PRODUCTION

# DHA Digital Health Agency (Kenya National Health Information Exchange)
DHA_HIE_BASE_URL=https://api.hie.dha.go.ke
DHA_CLIENT_ID=__PROD_DHA_GOV_CLIENT_ID__
DHA_CLIENT_SECRET=__PROD_DHA_GOV_CLIENT_SECRET__
DHA_DEFAULT_FACILITY_ID=FID-01-000001-1

# SHA Social Health Authority (eClaims & Pre-Authorization)
SHA_CLAIMS_BASE_URL=https://api.claims.sha.go.ke
SHA_API_KEY=__PROD_SHA_GOV_API_KEY__
SHA_FACILITY_CODE=FID-01-000001-1

# KRA eTIMS (Cryptographic Fiscal Invoicing)
KRA_ETIMS_BASE_URL=https://etims.kra.go.ke
KRA_ETIMS_PIN=P051234567Z
KRA_ETIMS_DEVICE_ID=ETIMS-PROD-OSCU-001

# Safaricom Daraja M-Pesa
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=__PROD_DARAJA_CONSUMER_KEY__
MPESA_CONSUMER_SECRET=__PROD_DARAJA_CONSUMER_SECRET__
MPESA_SHORTCODE=123456
MPESA_PASSKEY=__PROD_DARAJA_PASSKEY__
MPESA_CALLBACK_URL=https://api.afyapoa.co.ke/billing/mpesa/callback

# S3 Encrypted Object Storage (Nairobi Sovereign Bucket)
AWS_REGION=af-south-1
S3_MEDICAL_SCANS_BUCKET=afyapoa-prod-medical-scans
S3_BACKUP_ARCHIVE_BUCKET=afyapoa-prod-db-backups
