# infra/docker/Dockerfile.worker
# Multi-stage secure build for COMKEY AFYA POA BullMQ Background Worker Pods
# Dedicated to asynchronous outbox processing, claims transmission, and eTIMS fiscal signing

FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@10.30.2 --activate

FROM base AS builder
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @afyapoa/api build
RUN pnpm --filter @afyapoa/database build
RUN pnpm --filter @afyapoa/config build
RUN pnpm --filter @afyapoa/domain-core build
RUN pnpm --filter @afyapoa/fhir-models build
RUN pnpm --filter @afyapoa/integration-adapters build
RUN pnpm --filter @afyapoa/logger build
RUN pnpm prune --prod

FROM node:20-alpine AS runner
WORKDIR /app
RUN apk add --no-cache dumb-init
ENV NODE_ENV=production

RUN addgroup -g 10001 -S appgroup && \
    adduser -u 10001 -S workeruser -G appgroup

COPY --from=builder --chown=workeruser:appgroup /app/node_modules ./node_modules
COPY --from=builder --chown=workeruser:appgroup /app/packages ./packages
COPY --from=builder --chown=workeruser:appgroup /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=workeruser:appgroup /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=workeruser:appgroup /app/package.json ./package.json

USER workeruser

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "apps/api/dist/main.js"]
