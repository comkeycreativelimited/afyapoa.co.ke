# infra/docker/Dockerfile.web
# Multi-stage secure build for COMKEY AFYA POA Next.js 14 Frontend
# Hardened: Standalone Next.js bundle, non-root user (UID 10001), dumb-init process reaper

# Stage 1: Dependency & Build Base
FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@10.30.2 --activate

# Stage 2: Monorepo Source Build
FROM base AS builder
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

RUN pnpm install --frozen-lockfile

# Build internal dependencies and Next.js web application
RUN pnpm --filter @afyapoa/config build
RUN pnpm --filter @afyapoa/ui build
RUN pnpm --filter @afyapoa/web build

# Stage 3: Minimal Standalone Production Runner
FROM node:20-alpine AS runner
WORKDIR /app

RUN apk add --no-cache dumb-init wget
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1

# Create unprivileged system group and user
RUN addgroup -g 10001 -S nodejs && \
    adduser -u 10001 -S nextjs -G nodejs

# Copy Next.js standalone bundle and public assets
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

USER nextjs

EXPOSE 3000

# Container health probe
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "apps/web/server.js"]
