# .env.staging.example
# COMKEY AFYA POA — Staging / Pre-Production Rehearsal Configuration
# Connected to official DHA and SHA sandbox endpoints

NODE_ENV=staging
PORT=4000
WEB_PORT=3000

JWT_SECRET=staging-jwt-secret-min-32-chars-long-rnd-abc123
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=staging-refresh-secret-min-32-chars-long-rnd-xyz789
REFRESH_TOKEN_EXPIRATION=7d
KMS_PEPPER_SECRET=staging-blind-index-pepper-key-min-32-chars-hash

DATABASE_HOST=db.staging.internal.afyapoa.co.ke
DATABASE_PORT=5432
DATABASE_USER=afyapoa_staging_app
DATABASE_PASSWORD=staging_db_password_vault_injected
DATABASE_NAME=afyapoa_staging_db
DATABASE_URL=postgresql://afyapoa_staging_app:staging_db_password_vault_injected@db.staging.internal.afyapoa.co.ke:5432/afyapoa_staging_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

REDIS_HOST=redis.staging.internal.afyapoa.co.ke
REDIS_PORT=6379
REDIS_PASSWORD=staging_redis_token_vault_injected
REDIS_URL=redis://:staging_redis_token_vault_injected@redis.staging.internal.afyapoa.co.ke:6379

INTEGRATION_MODE=UAT
INTEGRATION_DRIVER=SANDBOX

DHA_HIE_BASE_URL=https://sandbox.hie.dha.go.ke
DHA_CLIENT_ID=staging-dha-sandbox-id
DHA_CLIENT_SECRET=staging-dha-sandbox-secret
DHA_DEFAULT_FACILITY_ID=FID-01-000101-1

SHA_CLAIMS_BASE_URL=https://sandbox.claims.sha.go.ke
SHA_API_KEY=staging-sha-sandbox-key
SHA_FACILITY_CODE=FID-01-000101-1

KRA_ETIMS_BASE_URL=https://etims-sbx.kra.go.ke
KRA_ETIMS_PIN=P000000000A
KRA_ETIMS_DEVICE_ID=ETIMS-SBX-DEVICE-001

MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=staging-daraja-key
MPESA_CONSUMER_SECRET=staging-daraja-secret
MPESA_SHORTCODE=174379

AWS_REGION=af-south-1
S3_MEDICAL_SCANS_BUCKET=afyapoa-staging-medical-scans
S3_BACKUP_ARCHIVE_BUCKET=afyapoa-staging-db-backups
