{
  "name": "afya-poa",
  "version": "0.1.0",
  "private": true,
  "description": "COMKEY AFYA POA — Multi-Tenant HMIS SaaS for Kenyan Healthcare Facilities",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "db:generate": "pnpm --filter @afyapoa/database db:generate",
    "db:migrate": "pnpm --filter @afyapoa/database db:migrate",
    "db:seed": "pnpm --filter @afyapoa/database db:seed",
    "infra:validate-env": "tsx infra/scripts/validate-env.ts",
    "infra:migrate": "tsx infra/scripts/db-migrate.ts",
    "infra:rollback": "tsx infra/scripts/db-rollback.ts",
    "infra:backup": "tsx infra/scripts/backup-encrypted.ts",
    "infra:restore": "tsx infra/scripts/restore-encrypted.ts",
    "infra:health": "tsx infra/scripts/health-audit.ts",
    "infra:rehearsal": "tsx infra/scripts/deployment-rehearsal.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "tinypool": ">=2.1.2",
      "body-parser": ">=1.20.9",
      "multer": ">=2.5.0",
      "postcss-selector-parser": ">=6.1.5"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
